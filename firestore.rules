            || ('inviteCode' in request.resource.data && request.resource.data.inviteCode == room(groupId).roomCode));
        allow update: if (owner(uid) && roomOpen(groupId) && validMember(request.resource.data, uid)
          && (resource.data.get('joined', true) || request.resource.data.get('joined', true) == false || (groupsEnabled() && (room(groupId).isPublic || room(groupId).createdById == uid || request.resource.data.get('inviteCode','') == room(groupId).roomCode))))
          || (canKick(groupId, uid) && validMember(request.resource.data, uid)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['joined', 'status', 'lastHeartbeat'])
            && request.resource.data.joined == false && request.resource.data.status == 'offline');
        allow delete: if canKick(groupId, uid);
      }
      match /messages/{messageId} {
        allow read: if admin() || canAccess(groupId);
        allow create: if canAccess(groupId) && siteOpen() && platformFlag('chatEnabled') && (platformFlag('chatAttachmentsEnabled') || !('image' in request.resource.data)) && validMessage(request.resource.data, groupId)
          && countedMessage(request.auth.uid,groupId,messageId);
        allow delete: if admin() || (canAccess(groupId) && (resource.data.senderUid==request.auth.uid || groupAdmin(groupId)));
      }
    }
    match /room_invites/{code} {
      function validInvite(data) {
        return data.keys().hasAll(['groupId','createdById']) && data.keys().hasOnly(['groupId','createdById'])
          && text(data.groupId,100) && data.createdById == request.auth.uid
          && getAfter(/databases/$(database)/documents/study_groups/$(data.groupId)).data.createdById == request.auth.uid
          && getAfter(/databases/$(database)/documents/study_groups/$(data.groupId)).data.roomCode == code;
      }
      allow get: if authenticated();
      allow create: if authenticated() && validInvite(request.resource.data);
      allow update: if false;
    }
  }
}
