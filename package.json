{
  "name": "sanctra",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/prerender-landing.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "archive:exam-data": "node scripts/archive-retired-exam-data.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy --only hosting",
    "test": "node --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-sanctra 'node --test tests/firebase/rules.test.mjs'",
    "api:spec": "npm --prefix integrations/hermes run build && node integrations/hermes/scripts/openapi.mjs",
    "api:spec:check": "npm --prefix integrations/hermes run build && node integrations/hermes/scripts/openapi.mjs --check",
    "test:session": "node --test tests/analytics.test.ts tests/timer-draft.test.ts tests/session-persistence-audit.test.ts tests/mergeStudyRecords.test.ts tests/focusMirror.test.ts tests/personal-sessions.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "katex": "^0.19.0",
    "lucide-react": "^1.49.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "protobufjs",
      "esbuild"
    ]
  }
}
